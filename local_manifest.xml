<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="ext"
           fetch="https://github.com/Los-Ext"
           revision="refs/heads/15.2" />

  <remote  name="crd"
           fetch="https://github.com/crdroidandroid"
           revision="refs/heads/15.0" />

  <remove-project path="art" />
  <remove-project path="bionic" />
  <remove-project path="build/make" />
  <remove-project path="build/soong" />
  <remove-project path="external/jemalloc_new" />

 <!-- LosExt additions -->
  <project path="build/make" name="android_build" groups="pdk,sysui-studio" remote="ext" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="android_build_soong" groups="pdk,tradefed,sysui-studio" remote="ext" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <project path="art" name="android_art" remote="ext" />
  <project path="bionic" name="android_bionic" remote="ext" />
  <project path="external/jemalloc_new" name="android_external_jemalloc-new" remote="crd" />

</manifest>
